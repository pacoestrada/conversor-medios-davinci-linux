#!/usr/bin/env bash
set -u
readonly TITULO="Conversor MP4 a MOV"
readonly VERSION="2.1.0"

mostrar_sin_gui() {
    local mensaje="$1"
    if command -v xmessage >/dev/null 2>&1; then xmessage -center "$mensaje"
    elif command -v notify-send >/dev/null 2>&1; then notify-send -u critical "$TITULO" "$mensaje"
    else printf '%s\n' "$mensaje" >&2; fi
}

if ! command -v zenity >/dev/null 2>&1; then
    mostrar_sin_gui "No se encuentra Zenity. Instálalo desde el gestor de software."
    exit 1
fi

# Presentación breve de la aplicación. Se cierra sola o al pulsar Aceptar.
zenity --info \
    --title="$TITULO $VERSION" \
    --icon-name="com.pacoestrada.ConversorMp4Mov" \
    --width=460 \
    --timeout=5 \
    --text="<big><b>Conversor MP4 a MOV</b></big>\n\nConversión de medios sencilla para Linux\n\n<b>Creado por Paco Estrada</b>" \
    2>/dev/null || true

for orden in ffmpeg ffprobe; do
    if ! command -v "$orden" >/dev/null 2>&1; then
        zenity --error --title="$TITULO" --width=470 --text="No se encuentra FFmpeg. Instálalo desde el gestor de software o con: sudo apt install ffmpeg"
        exit 1
    fi
done

MODO="$(zenity --list --radiolist --title="$TITULO $VERSION" --width=560 --height=290 \
    --text="¿Qué quieres convertir?" --column="" --column="Selección" \
    TRUE "Una carpeta (incluye subcarpetas)" FALSE "Uno o varios archivos MP4")" || exit 0

ARCHIVOS_MP4=()
if [[ "$MODO" == "Una carpeta (incluye subcarpetas)" ]]; then
    CARPETA_ORIGEN="$(zenity --file-selection --directory --title="Selecciona la carpeta que contiene los MP4" --filename="${HOME:-/}/")" || exit 0
    if [[ ! -d "$CARPETA_ORIGEN" || ! -r "$CARPETA_ORIGEN" ]]; then
        zenity --error --title="$TITULO" --text="No se puede leer la carpeta seleccionada."
        exit 1
    fi
    CARPETA_ORIGEN="$(cd -- "$CARPETA_ORIGEN" && pwd -P)"
    mapfile -d '' ARCHIVOS_MP4 < <(find "$CARPETA_ORIGEN" -type f -iname '*.mp4' -print0 | sort -z)
else
    SELECCION="$(zenity --file-selection --multiple --separator=$'\n' --title="Selecciona uno o varios archivos MP4" \
        --file-filter="Vídeos MP4 | *.mp4 *.MP4" --file-filter="Todos los archivos | *")" || exit 0
    while IFS= read -r archivo; do
        [[ -n "$archivo" && -f "$archivo" && "${archivo,,}" == *.mp4 ]] && ARCHIVOS_MP4+=("$archivo")
    done <<< "$SELECCION"
fi

if (( ${#ARCHIVOS_MP4[@]} == 0 )); then
    zenity --info --title="$TITULO" --width=450 --text="No se han encontrado archivos MP4 válidos."
    exit 0
fi

PENDIENTES=(); OMITIDOS=0
for video in "${ARCHIVOS_MP4[@]}"; do
    if [[ -e "${video%.*}.mov" ]]; then ((OMITIDOS += 1)); else PENDIENTES+=("$video"); fi
done
TOTAL=${#PENDIENTES[@]}
if (( TOTAL == 0 )); then
    zenity --info --title="$TITULO" --width=470 --text="No hay nada pendiente.\n\nOmitidos porque su MOV ya existe: $OMITIDOS"
    exit 0
fi

TEMPORAL="$(mktemp -d)"
RESULTADO="$TEMPORAL/resultado"; ERRORES_TXT="$TEMPORAL/errores"
trap 'rm -rf -- "$TEMPORAL"' EXIT

explicar_error() {
    local registro="$1" detalle
    detalle="$(grep -Eiv '^(ffmpeg version|  built with|  configuration:|  lib[a-z]+)' "$registro" | tail -n 4 | tr '\n' ' ' | sed 's/[[:space:]]\+/ /g')"
    if grep -qiE 'invalid data|moov atom not found|could not find codec parameters' "$registro"; then printf 'El MP4 parece incompleto o dañado. %s' "$detalle"
    elif grep -qiE 'permission denied|read-only file system' "$registro"; then printf 'No hay permiso para leer el origen o escribir el MOV. %s' "$detalle"
    elif grep -qiE 'no space left on device' "$registro"; then printf 'No queda espacio libre en el disco de destino. %s' "$detalle"
    elif grep -qiE 'does not contain any stream|matches no streams' "$registro"; then printf 'El archivo no contiene pistas de vídeo o audio utilizables. %s' "$detalle"
    else printf 'FFmpeg no pudo completar la conversión. %s' "${detalle:-Sin detalle adicional.}"; fi
}

validar_salida() {
    local origen="$1" destino="$2" video_origen video_destino audio_origen audio_destino pista huella_origen huella_destino duraciones_origen duraciones_destino
    video_origen="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,r_frame_rate -of csv=p=0 "$origen")" || return 1
    video_destino="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,r_frame_rate -of csv=p=0 "$destino")" || return 1
    if [[ -z "$video_origen" || "$video_origen" != "$video_destino" ]]; then
        echo 'La pista de vídeo falta o sus propiedades han cambiado.' >&2; return 1
    fi
    # Comparar el contenido comprimido, sin decodificar ni recodificar el vídeo.
    huella_origen="$(ffmpeg -nostdin -v error -i "$origen" -map 0:v:0 -c:v copy -f hash -)" || return 1
    huella_destino="$(ffmpeg -nostdin -v error -i "$destino" -map 0:v:0 -c:v copy -f hash -)" || return 1
    if [[ -z "$huella_origen" || "$huella_origen" != "$huella_destino" ]]; then
        echo 'El contenido del vídeo no coincide con el original.' >&2; return 1
    fi
    audio_origen="$(ffprobe -v error -select_streams a -show_entries stream=channels -of csv=p=0 "$origen")" || return 1
    audio_destino="$(ffprobe -v error -select_streams a -show_entries stream=channels -of csv=p=0 "$destino")" || return 1
    if [[ "$audio_origen" != "$audio_destino" ]]; then
        echo 'Faltan pistas de audio o ha cambiado su número de canales.' >&2; return 1
    fi
    if [[ -n "$audio_origen" ]]; then
        pista="$(ffprobe -v error -select_streams a -show_entries stream=codec_name,sample_rate -of csv=p=0 "$destino")" || return 1
        while IFS= read -r linea; do
            if [[ "$linea" != 'pcm_s24le,48000' ]]; then
                echo 'El audio de salida no es PCM de 24 bits a 48 kHz.' >&2; return 1
            fi
        done <<< "$pista"
        duraciones_origen="$(ffprobe -v error -select_streams a -show_entries stream=duration -of csv=p=0 "$origen")" || return 1
        duraciones_destino="$(ffprobe -v error -select_streams a -show_entries stream=duration -of csv=p=0 "$destino")" || return 1
        if ! paste <(printf '%s\n' "$duraciones_origen") <(printf '%s\n' "$duraciones_destino") | awk '
            NF != 2 || $1 !~ /^[0-9]+([.][0-9]+)?$/ || $2 !~ /^[0-9]+([.][0-9]+)?$/ { fallo=1; next }
            $1 <= 0 || $2 <= 0 || $1-$2 > 0.1 || $2-$1 > 0.1 { fallo=1 }
            END { exit fallo }'; then
            echo 'La duración del audio no coincide con el original o está vacía.' >&2; return 1
        fi
        ffmpeg -nostdin -v error -xerror -i "$destino" -map 0:a -f null - || return 1
    fi
}

(
    parcial=""
    trap '[[ -z "$parcial" ]] || rm -f -- "$parcial"' EXIT
    correctos=0; fallidos=0; indice=0; : > "$ERRORES_TXT"; echo 0
    for video in "${PENDIENTES[@]}"; do
        salida="${video%.*}.mov"
        if ! parcial="$(mktemp --tmpdir="$(dirname -- "$video")" .conversor-XXXXXXXX.mov)"; then
            printf '%s\tNo se pudo crear la salida temporal junto al MP4. Comprueba permisos y espacio libre.\n' "$video" >> "$ERRORES_TXT"
            ((fallidos += 1)); ((indice += 1)); echo "$((indice * 100 / TOTAL))"
            continue
        fi
        log_compat="$TEMPORAL/compat-$indice.log"
        nombre_mostrado="$(basename -- "$video")"; nombre_mostrado="${nombre_mostrado//$'\n'/ }"
        echo "$((indice * 100 / TOTAL))"
        printf '# Procesando %d de %d: %s\n' "$((indice + 1))" "$TOTAL" "$nombre_mostrado"

        log_validacion="$TEMPORAL/validacion-$indice.log"
        if ffmpeg -nostdin -y -hide_banner -loglevel error -i "$video" \
            -map 0:v:0 -map '0:a?' -c:v copy -c:a pcm_s24le -ar 48000 \
            -map_metadata 0 -movflags +faststart "$parcial" 2>"$log_compat"; then
            printf '# Comprobando vídeo y audio: %s\n' "$nombre_mostrado"
            if validar_salida "$video" "$parcial" 2>"$log_validacion"; then
                # No sobrescribir un destino creado mientras se convertía.
                if mv -n -- "$parcial" "$salida" 2>"$log_validacion" && [[ ! -e "$parcial" ]]; then
                    ((correctos += 1))
                else
                    printf '%s\tNo se pudo guardar el MOV; puede existir ya o faltar permisos.\n' "$video" >> "$ERRORES_TXT"
                    ((fallidos += 1))
                fi
            else
                motivo="$(cat -- "$log_validacion")"
                printf '%s\t%s\n' "$video" "${motivo:-No se pudieron verificar las pistas de salida.}" >> "$ERRORES_TXT"
                ((fallidos += 1))
            fi
        else
            motivo="$(explicar_error "$log_compat")"
            printf '%s\t%s\n' "$video" "$motivo" >> "$ERRORES_TXT"
            ((fallidos += 1))
        fi
        rm -f -- "$parcial"
        ((indice += 1)); echo "$((indice * 100 / TOTAL))"
    done
    printf '%d %d\n' "$correctos" "$fallidos" > "$RESULTADO"
) | zenity --progress --title="$TITULO" --width=580 --text="Preparando la conversión…" --percentage=0 --auto-close --no-cancel

if [[ ! -s "$RESULTADO" ]]; then
    zenity --error --title="$TITULO" --width=470 --text="La conversión se interrumpió inesperadamente."
    exit 1
fi
read -r CORRECTOS FALLIDOS < "$RESULTADO"
resumen="Convertidos: $CORRECTOS\nOmitidos: $OMITIDOS\nFallidos: $FALLIDOS"
if (( FALLIDOS == 0 )); then
    zenity --info --title="$TITULO" --width=470 --text="<span foreground='#16803c'><b>● Conversión correcta y verificada</b></span>\n\n$resumen\n\nVídeo intacto. Audio PCM de 24 bits a 48 kHz cuando el original contiene audio. Los omitidos no se han comprobado."
else
    detalle="$(awk -F '\t' '{printf "• %s\n  %s\n", $1, $2}' "$ERRORES_TXT")"
    detalle="$(printf '%s' "$detalle" | sed 's/\&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
    zenity --error --title="$TITULO" --width=720 --height=440 --text="<span foreground='#c62828'><b>● Conversión con fallos</b></span>\n\n$resumen\n\n$detalle"
    exit 1
fi
